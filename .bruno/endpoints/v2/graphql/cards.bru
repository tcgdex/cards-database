meta {
  name: cards
  type: graphql
  seq: 1
}

post {
  url: {{BASE_URL}}/v2/graphql
  body: graphql
  auth: none
}

body:graphql {
  query Pouet {
    cards(pagination: { page: 1, itemsPerPage: 4 }) {
      id
      localId
      name
      set {
        id
        name
        serie {
          id
          name
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.data.cards.length: eq 4
  res.body.data.cards[0].set.serie.id: isDefined
}
